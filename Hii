          {/* Interior Grid: 2 Columns */}
          <div className="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 xl:gap-16 items-center relative z-10">
            
            {/* Left Column: Brand Name & Navigation Down on the Left (Clean, Spacious, No Overlap) */}
            <div className="lg:col-span-7 flex flex-col justify-between text-left h-full">
              <div>
                {/* Refined Eyebrow */}
                <div className="flex items-center gap-3 mb-4 sm:mb-5">
                  <span className="w-8 h-px bg-[#d49887]/80" />
                  <span className="text-[11px] sm:text-xs uppercase tracking-[0.28em] text-[#d49887] font-medium font-sans-clean">
                    STUDIO & EDITORIAL ARCHIVE
                  </span>
                </div>

                {/* The Daily Drapes Brand Name with deliberate, non-overlapping line heights */}
                <h1 className="font-display font-black text-4xl sm:text-5xl md:text-6xl lg:text-[68px] xl:text-[76px] text-[#f3ded2] tracking-tight leading-[1.06] sm:leading-[1.02] uppercase select-none my-3 sm:my-4 drop-shadow-md">
                  THE DAILY <br />
