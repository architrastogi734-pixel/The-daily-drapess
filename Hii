      <div className="max-w-7xl mx-auto px-5 sm:px-8 w-full relative z-10">
        
        {/* Main Architectural Vertical Rectangle Container */}
        <div className="relative max-w-6xl mx-auto rounded-3xl border border-[#3e131b] bg-[#19060b]/95 backdrop-blur-md p-6 sm:p-10 lg:p-12 xl:p-14 shadow-2xl shadow-black/90">
          
