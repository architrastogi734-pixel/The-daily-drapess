import React, { useState } from 'react';
import Navbar from './components/Navbar';
import HeroSection from './components/HeroSection';
import AboutSection from './components/AboutSection';
import FeaturedWorkSection from './components/FeaturedWorkSection';
import CaseStudiesSection from './components/CaseStudiesSection';
import NailBoardSection from './components/NailBoardSection';
import ProcessSection from './components/ProcessSection';
import ConnectSection from './components/ConnectSection';
import Footer from './components/Footer';
import SocialUrlModal from './components/SocialUrlModal';

export default function App() {
  const [socialModalOpen, setSocialModalOpen] = useState(false);
  const [activePlatform, setActivePlatform] = useState<'pinterest' | 'threads'>('pinterest');

  const handleOpenSocialModal = (platform: 'pinterest' | 'threads') => {
    setActivePlatform(platform);
    setSocialModalOpen(true);
  };

  return (
    <div className="min-h-screen bg-[#120508] text-[#ecd0c3] flex flex-col font-sans-clean selection:bg-[#d49887] selection:text-[#120508]">
      {/* Top Fixed Editorial Navigation */}
      <Navbar onOpenSocialModal={handleOpenSocialModal} />

      {/* Main Content Sections */}
      <main className="flex-grow">
        <HeroSection onOpenSocialModal={handleOpenSocialModal} />
        <AboutSection />
        <FeaturedWorkSection />
        <CaseStudiesSection />
        <NailBoardSection onOpenSocialModal={handleOpenSocialModal} />
        <ProcessSection />
        <ConnectSection onOpenSocialModal={handleOpenSocialModal} />
      </main>

      {/* Footer */}
      <Footer onOpenSocialModal={handleOpenSocialModal} />

      {/* Social URL Customizer Modal */}
      <SocialUrlModal
        isOpen={socialModalOpen}
        onClose={() => setSocialModalOpen(false)}
        platform={activePlatform}
      />
    </div>
  );
}
import React from 'react';
