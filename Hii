                {/* Pillars */}
                <div className="flex flex-wrap items-center gap-2 text-[11px] sm:text-xs uppercase tracking-[0.25em] text-[#a67c74] font-medium mb-8 sm:mb-10">
                  <span>BRANDING</span>
                  <span className="text-[#d49887]">•</span>
                  <span>WEB DESIGN</span>
                  <span className="text-[#d49887]">•</span>
                  <span>CREATIVE DIRECTION</span>
